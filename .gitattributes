* text=auto

# This repository is maintained on Windows but developed/run on Linux and WSL.
# Force LF for every text format so scripts and Go sources stay usable from
# /mnt/d without CRLF contamination.
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.html text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.ps1 text eol=lf
*.png binary
*.jpg binary
*.webp binary
*.xz binary
*.gz binary
