{
  "name": "pcl-dsh-web",
  "private": true,
  "version": "0.3.2",
  "description": "PCL-DSH-Linux Web UI: Vue 3 + TypeScript + Vite port of the HDSL desktop launcher",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "pinia": "3.0.3",
    "vue": "3.5.22",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "24.3.0",
    "@vitejs/plugin-vue": "6.0.1",
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "vue-tsc": "3.0.6"
  }
}
